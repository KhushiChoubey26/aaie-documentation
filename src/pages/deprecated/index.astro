---
import Layout from '../../layouts/Layout.astro';
---

<Layout title="Deprecated - AAIE Documentation">
  <div class="px-4 sm:px-6 lg:px-8">
    <div class="mb-8">
      <nav class="flex" aria-label="Breadcrumb">
        <ol class="inline-flex items-center space-x-1 md:space-x-3">
          <li class="inline-flex items-center">
            <a href="/" class="text-gray-500 hover:text-gray-700">Home</a>
          </li>
          <li>
            <div class="flex items-center">
              <svg class="w-6 h-6 text-gray-400" fill="currentColor" viewBox="0 0 20 20">
                <path fill-rule="evenodd" d="M7.293 14.707a1 1 0 010-1.414L10.586 10 7.293 6.707a1 1 0 011.414-1.414l4 4a1 1 0 010 1.414l-4 4a1 1 0 01-1.414 0z" clip-rule="evenodd"></path>
              </svg>
              <span class="ml-1 text-sm font-medium text-gray-500 md:ml-2">Deprecated</span>
            </div>
          </li>
        </ol>
      </nav>
    </div>

    <div class="mb-8">
      <h1 class="text-3xl font-bold text-gray-900 mb-4">Deprecated Documentation</h1>
      <p class="text-lg text-gray-600">
        Outdated documentation and deprecated features that are no longer actively maintained. 
        This section is kept for historical reference and migration purposes.
      </p>
    </div>

    <div class="bg-yellow-50 border-l-4 border-yellow-400 p-4 mb-8">
      <div class="flex">
        <div class="flex-shrink-0">
          <svg class="h-5 w-5 text-yellow-400" viewBox="0 0 20 20" fill="currentColor">
            <path fill-rule="evenodd" d="M8.257 3.099c.765-1.36 2.722-1.36 3.486 0l5.58 9.92c.75 1.334-.213 2.98-1.742 2.98H4.42c-1.53 0-2.493-1.646-1.743-2.98l5.58-9.92zM11 13a1 1 0 11-2 0 1 1 0 012 0zm-1-8a1 1 0 00-1 1v3a1 1 0 002 0V6a1 1 0 00-1-1z" clip-rule="evenodd" />
          </svg>
        </div>
        <div class="ml-3">
          <p class="text-sm text-yellow-700">
            <strong>Warning:</strong> The content in this section is deprecated and may not reflect current project status. 
            Please refer to the active documentation sections for up-to-date information.
          </p>
        </div>
      </div>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 mb-8">
      <!-- Legacy APIs -->
      <div class="card">
        <div class="flex items-center mb-4">
          <div class="w-10 h-10 bg-gray-100 rounded-lg flex items-center justify-center">
            <svg class="w-6 h-6 text-gray-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 9l3 3-3 3m5 0h3M5 20h14a2 2 0 002-2V6a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"></path>
            </svg>
          </div>
          <h3 class="text-lg font-semibold text-gray-900 ml-3">Legacy APIs</h3>
        </div>
        <p class="text-gray-600 mb-4">Deprecated API endpoints and interfaces.</p>
        <a href="/deprecated/legacy-apis/" class="text-gray-600 hover:text-gray-800 font-medium">View →</a>
      </div>

      <!-- Old Models -->
      <div class="card">
        <div class="flex items-center mb-4">
          <div class="w-10 h-10 bg-gray-100 rounded-lg flex items-center justify-center">
            <svg class="w-6 h-6 text-gray-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19.428 15.428a2 2 0 00-1.022-.547l-2.387-.477a6 6 0 00-3.86.517l-.318.158a6 6 0 01-3.86.517L6.05 15.21a2 2 0 00-1.806.547M8 4h8l-1 1v5.172a2 2 0 00.586 1.414l5 5c1.26 1.26.367 3.414-1.415 3.414H4.828c-1.782 0-2.674-2.154-1.414-3.414l5-5A2 2 0 009 10.172V5L8 4z"></path>
            </svg>
          </div>
          <h3 class="text-lg font-semibold text-gray-900 ml-3">Old Models</h3>
        </div>
        <p class="text-gray-600 mb-4">Previous AI model versions and architectures.</p>
        <a href="/deprecated/old-models/" class="text-gray-600 hover:text-gray-800 font-medium">View →</a>
      </div>

      <!-- Outdated Configs -->
      <div class="card">
        <div class="flex items-center mb-4">
          <div class="w-10 h-10 bg-gray-100 rounded-lg flex items-center justify-center">
            <svg class="w-6 h-6 text-gray-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z"></path>
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"></path>
            </svg>
          </div>
          <h3 class="text-lg font-semibold text-gray-900 ml-3">Outdated Configs</h3>
        </div>
        <p class="text-gray-600 mb-4">Deprecated configuration files and settings.</p>
        <a href="/deprecated/configs/" class="text-gray-600 hover:text-gray-800 font-medium">View →</a>
      </div>

      <!-- Migration Guides -->
      <div class="card">
        <div class="flex items-center mb-4">
          <div class="w-10 h-10 bg-blue-100 rounded-lg flex items-center justify-center">
            <svg class="w-6 h-6 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7h12m0 0l-4-4m4 4l-4 4m0 6H4m0 0l4 4m-4-4l4-4"></path>
            </svg>
          </div>
          <h3 class="text-lg font-semibold text-gray-900 ml-3">Migration Guides</h3>
        </div>
        <p class="text-gray-600 mb-4">Guides for upgrading from deprecated features.</p>
        <a href="/deprecated/migration/" class="text-blue-600 hover:text-blue-800 font-medium">View →</a>
      </div>

      <!-- Changelog -->
      <div class="card">
        <div class="flex items-center mb-4">
          <div class="w-10 h-10 bg-green-100 rounded-lg flex items-center justify-center">
            <svg class="w-6 h-6 text-green-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path>
            </svg>
          </div>
          <h3 class="text-lg font-semibold text-gray-900 ml-3">Changelog</h3>
        </div>
        <p class="text-gray-600 mb-4">Historical changes and deprecation notices.</p>
        <a href="/deprecated/changelog/" class="text-green-600 hover:text-green-800 font-medium">View →</a>
      </div>

      <!-- Archive -->
      <div class="card">
        <div class="flex items-center mb-4">
          <div class="w-10 h-10 bg-purple-100 rounded-lg flex items-center justify-center">
            <svg class="w-6 h-6 text-purple-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 8h14M5 8a2 2 0 110-4h14a2 2 0 110 4M5 8v10a2 2 0 002 2h10a2 2 0 002-2V8m-9 4h4"></path>
            </svg>
          </div>
          <h3 class="text-lg font-semibold text-gray-900 ml-3">Archive</h3>
        </div>
        <p class="text-gray-600 mb-4">Complete archive of deprecated content.</p>
        <a href="/deprecated/archive/" class="text-purple-600 hover:text-purple-800 font-medium">View →</a>
      </div>
    </div>

    <div class="bg-gray-50 rounded-lg p-6">
      <h2 class="text-lg font-semibold text-gray-900 mb-2">About This Section</h2>
      <p class="text-gray-700 mb-4">
        This section contains documentation for features and components that have been deprecated or replaced 
        by newer alternatives. While this content is no longer actively maintained, it may be useful for:
      </p>
      <ul class="text-gray-700 list-disc list-inside space-y-2">
        <li>Understanding the evolution of the AAIE project</li>
        <li>Migrating from older versions to current releases</li>
        <li>Historical reference and research purposes</li>
        <li>Debugging legacy systems that may still be in use</li>
      </ul>
    </div>

    <div class="mt-8 bg-blue-50 rounded-lg p-6">
      <h2 class="text-lg font-semibold text-blue-900 mb-2">Need Help?</h2>
      <p class="text-blue-700 mb-4">
        If you're working with deprecated features or need help migrating to current versions, 
        please check the migration guides or contact the development team for assistance.
      </p>
      <div class="flex space-x-4">
        <a href="/forking-worflow/" class="text-blue-600 hover:text-blue-800 font-medium underline">View Workflow Guide</a>
        <a href="/" class="text-blue-600 hover:text-blue-800 font-medium underline">Return to Home</a>
      </div>
    </div>
  </div>
</Layout>
