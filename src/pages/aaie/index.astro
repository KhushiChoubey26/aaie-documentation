---
import Layout from '../../layouts/Layout.astro';
---

<Layout title="Core AAIE - AAIE Documentation">
  <div class="px-4 sm:px-6 lg:px-8">
    <div class="mb-8">
      <nav class="flex" aria-label="Breadcrumb">
        <ol class="inline-flex items-center space-x-1 md:space-x-3">
          <li class="inline-flex items-center">
            <a href="/" class="text-gray-500 hover:text-gray-700">Home</a>
          </li>
          <li>
            <div class="flex items-center">
              <svg class="w-6 h-6 text-gray-400" fill="currentColor" viewBox="0 0 20 20">
                <path fill-rule="evenodd" d="M7.293 14.707a1 1 0 010-1.414L10.586 10 7.293 6.707a1 1 0 011.414-1.414l4 4a1 1 0 010 1.414l-4 4a1 1 0 01-1.414 0z" clip-rule="evenodd"></path>
              </svg>
              <span class="ml-1 text-sm font-medium text-gray-500 md:ml-2">Core AAIE</span>
            </div>
          </li>
        </ol>
      </nav>
    </div>

    <div class="mb-8">
      <h1 class="text-3xl font-bold text-gray-900 mb-4">Core AAIE Documentation</h1>
      <p class="text-lg text-gray-600">
        Core project documentation, architecture, and implementation details for the Artificial Assessment Intelligence for Educators (AAIE) project.
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 mb-8">
      <!-- Architecture -->
      <div class="card">
        <div class="flex items-center mb-4">
          <div class="w-10 h-10 bg-blue-100 rounded-lg flex items-center justify-center">
            <svg class="w-6 h-6 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"></path>
            </svg>
          </div>
          <h3 class="text-lg font-semibold text-gray-900 ml-3">Architecture</h3>
        </div>
        <p class="text-gray-600 mb-4">System architecture diagrams and design patterns.</p>
        <a href="/aaie/architecture/" class="text-blue-600 hover:text-blue-800 font-medium">View →</a>
      </div>

      <!-- Implementation -->
      <div class="card">
        <div class="flex items-center mb-4">
          <div class="w-10 h-10 bg-green-100 rounded-lg flex items-center justify-center">
            <svg class="w-6 h-6 text-green-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4"></path>
            </svg>
          </div>
          <h3 class="text-lg font-semibold text-gray-900 ml-3">Implementation</h3>
        </div>
        <p class="text-gray-600 mb-4">Code implementation details and examples.</p>
        <a href="/aaie/implementation/" class="text-green-600 hover:text-green-800 font-medium">View →</a>
      </div>

      <!-- API Reference -->
      <div class="card">
        <div class="flex items-center mb-4">
          <div class="w-10 h-10 bg-purple-100 rounded-lg flex items-center justify-center">
            <svg class="w-6 h-6 text-purple-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 9l3 3-3 3m5 0h3M5 20h14a2 2 0 002-2V6a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"></path>
            </svg>
          </div>
          <h3 class="text-lg font-semibold text-gray-900 ml-3">API Reference</h3>
        </div>
        <p class="text-gray-600 mb-4">API documentation and endpoints.</p>
        <a href="/aaie/api/" class="text-purple-600 hover:text-purple-800 font-medium">View →</a>
      </div>

      <!-- Configuration -->
      <div class="card">
        <div class="flex items-center mb-4">
          <div class="w-10 h-10 bg-orange-100 rounded-lg flex items-center justify-center">
            <svg class="w-6 h-6 text-orange-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z"></path>
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"></path>
            </svg>
          </div>
          <h3 class="text-lg font-semibold text-gray-900 ml-3">Configuration</h3>
        </div>
        <p class="text-gray-600 mb-4">System configuration and environment setup.</p>
        <a href="/aaie/configuration/" class="text-orange-600 hover:text-orange-800 font-medium">View →</a>
      </div>

      <!-- Testing -->
      <div class="card">
        <div class="flex items-center mb-4">
          <div class="w-10 h-10 bg-red-100 rounded-lg flex items-center justify-center">
            <svg class="w-6 h-6 text-red-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path>
            </svg>
          </div>
          <h3 class="text-lg font-semibold text-gray-900 ml-3">Testing</h3>
        </div>
        <p class="text-gray-600 mb-4">Testing strategies and test coverage.</p>
        <a href="/aaie/testing/" class="text-red-600 hover:text-red-800 font-medium">View →</a>
      </div>

      <!-- Deployment -->
      <div class="card">
        <div class="flex items-center mb-4">
          <div class="w-10 h-10 bg-indigo-100 rounded-lg flex items-center justify-center">
            <svg class="w-6 h-6 text-indigo-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 16a4 4 0 01-.88-7.903A5 5 0 1115.9 6L16 6a5 5 0 011 9.9M9 19l3 3m0 0l3-3m-3 3V10"></path>
            </svg>
          </div>
          <h3 class="text-lg font-semibold text-gray-900 ml-3">Deployment</h3>
        </div>
        <p class="text-gray-600 mb-4">Deployment procedures and CI/CD setup.</p>
        <a href="/aaie/deployment/" class="text-indigo-600 hover:text-indigo-800 font-medium">View →</a>
      </div>
    </div>

    <div class="bg-blue-50 rounded-lg p-6">
      <h2 class="text-lg font-semibold text-blue-900 mb-2">Getting Started with Core AAIE</h2>
      <p class="text-blue-700 mb-4">
        Start with the architecture overview to understand the system design, then explore implementation details, 
        API references, and configuration options. Each section provides comprehensive documentation for that aspect of the project.
      </p>
    </div>
  </div>
</Layout>
