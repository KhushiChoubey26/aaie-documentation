---
import Layout from '../../layouts/Layout.astro';
---

<Layout title="Design Engineering - AAIE Documentation">
  <div class="px-4 sm:px-6 lg:px-8">
    <div class="mb-8">
      <nav class="flex" aria-label="Breadcrumb">
        <ol class="inline-flex items-center space-x-1 md:space-x-3">
          <li class="inline-flex items-center">
            <a href="/" class="text-gray-500 hover:text-gray-700">Home</a>
          </li>
          <li>
            <div class="flex items-center">
              <svg class="w-6 h-6 text-gray-400" fill="currentColor" viewBox="0 0 20 20">
                <path fill-rule="evenodd" d="M7.293 14.707a1 1 0 010-1.414L10.586 10 7.293 6.707a1 1 0 011.414-1.414l4 4a1 1 0 010 1.414l-4 4a1 1 0 01-1.414 0z" clip-rule="evenodd"></path>
              </svg>
              <span class="ml-1 text-sm font-medium text-gray-500 md:ml-2">Design Engineering</span>
            </div>
          </li>
        </ol>
      </nav>
    </div>

    <div class="mb-8">
      <h1 class="text-3xl font-bold text-gray-900 mb-4">Design Engineering Documentation</h1>
      <p class="text-lg text-gray-600">
        System design, architecture, and engineering documentation for the AAIE project. Explore system architecture, 
        design patterns, and engineering best practices.
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 mb-8">
      <!-- System Architecture -->
      <div class="card">
        <div class="flex items-center mb-4">
          <div class="w-10 h-10 bg-blue-100 rounded-lg flex items-center justify-center">
            <svg class="w-6 h-6 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"></path>
            </svg>
          </div>
          <h3 class="text-lg font-semibold text-gray-900 ml-3">System Architecture</h3>
        </div>
        <p class="text-gray-600 mb-4">High-level system design and component architecture.</p>
        <a href="/aaie-design-engineering/architecture/" class="text-blue-600 hover:text-blue-800 font-medium">View →</a>
      </div>

      <!-- Design Patterns -->
      <div class="card">
        <div class="flex items-center mb-4">
          <div class="w-10 h-10 bg-green-100 rounded-lg flex items-center justify-center">
            <svg class="w-6 h-6 text-green-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 5a1 1 0 011-1h14a1 1 0 011 1v2a1 1 0 01-1 1H5a1 1 0 01-1-1V5zM4 13a1 1 0 011-1h6a1 1 0 011 1v6a1 1 0 01-1 1H5a1 1 0 01-1-1v-6zM16 13a1 1 0 011-1h2a1 1 0 011 1v6a1 1 0 01-1 1h-2a1 1 0 01-1-1v-6z"></path>
            </svg>
          </div>
          <h3 class="text-lg font-semibold text-gray-900 ml-3">Design Patterns</h3>
        </div>
        <p class="text-gray-600 mb-4">Software design patterns and architectural solutions.</p>
        <a href="/aaie-design-engineering/patterns/" class="text-green-600 hover:text-green-800 font-medium">View →</a>
      </div>

      <!-- API Design -->
      <div class="card">
        <div class="flex items-center mb-4">
          <div class="w-10 h-10 bg-purple-100 rounded-lg flex items-center justify-center">
            <svg class="w-6 h-6 text-purple-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 9l3 3-3 3m5 0h3M5 20h14a2 2 0 002-2V6a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"></path>
            </svg>
          </div>
          <h3 class="text-lg font-semibold text-gray-900 ml-3">API Design</h3>
        </div>
        <p class="text-gray-600 mb-4">API design principles and interface specifications.</p>
        <a href="/aaie-design-engineering/api-design/" class="text-purple-600 hover:text-purple-800 font-medium">View →</a>
      </div>

      <!-- Database Design -->
      <div class="card">
        <div class="flex items-center mb-4">
          <div class="w-10 h-10 bg-orange-100 rounded-lg flex items-center justify-center">
            <svg class="w-6 h-6 text-orange-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 7v10c0 2.21 3.582 4 8 4s8-1.79 8-4V7M4 7c0 2.21 3.582 4 8 4s8-1.79 8-4M4 7c0-2.21 3.582-4 8-4s8 1.79 8 4"></path>
            </svg>
          </div>
          <h3 class="text-lg font-semibold text-gray-900 ml-3">Database Design</h3>
        </div>
        <p class="text-gray-600 mb-4">Database schemas, relationships, and optimization.</p>
        <a href="/aaie-design-engineering/database/" class="text-orange-600 hover:text-orange-800 font-medium">View →</a>
      </div>

      <!-- Security Design -->
      <div class="card">
        <div class="flex items-center mb-4">
          <div class="w-10 h-10 bg-red-100 rounded-lg flex items-center justify-center">
            <svg class="w-6 h-6 text-red-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"></path>
            </svg>
          </div>
          <h3 class="text-lg font-semibold text-gray-900 ml-3">Security Design</h3>
        </div>
        <p class="text-gray-600 mb-4">Security architecture and threat modeling.</p>
        <a href="/aaie-design-engineering/security/" class="text-red-600 hover:text-red-800 font-medium">View →</a>
      </div>

      <!-- Performance Design -->
      <div class="card">
        <div class="flex items-center mb-4">
          <div class="w-10 h-10 bg-indigo-100 rounded-lg flex items-center justify-center">
            <svg class="w-6 h-6 text-indigo-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"></path>
            </svg>
          </div>
          <h3 class="text-lg font-semibold text-gray-900 ml-3">Performance Design</h3>
        </div>
        <p class="text-gray-600 mb-4">Performance optimization and scalability patterns.</p>
        <a href="/aaie-design-engineering/performance/" class="text-indigo-600 hover:text-indigo-800 font-medium">View →</a>
      </div>
    </div>

    <div class="bg-orange-50 rounded-lg p-6">
      <h2 class="text-lg font-semibold text-orange-900 mb-2">Design Engineering Overview</h2>
      <p class="text-orange-700 mb-4">
        Design Engineering focuses on creating robust, scalable, and maintainable system architectures. 
        It encompasses everything from high-level system design to detailed implementation patterns, 
        ensuring the AAIE platform meets performance, security, and usability requirements.
      </p>
    </div>
  </div>
</Layout>
