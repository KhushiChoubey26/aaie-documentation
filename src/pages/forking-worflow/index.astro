---
import Layout from '../../layouts/Layout.astro';
---

<Layout title="Forking Workflow - AAIE Documentation">
  <div class="px-4 sm:px-6 lg:px-8">
    <div class="mb-8">
      <nav class="flex" aria-label="Breadcrumb">
        <ol class="inline-flex items-center space-x-1 md:space-x-3">
          <li class="inline-flex items-center">
            <a href="/" class="text-gray-500 hover:text-gray-700">Home</a>
          </li>
          <li>
            <div class="flex items-center">
              <svg class="w-6 h-6 text-gray-400" fill="currentColor" viewBox="0 0 20 20">
                <path fill-rule="evenodd" d="M7.293 14.707a1 1 0 010-1.414L10.586 10 7.293 6.707a1 1 0 011.414-1.414l4 4a1 1 0 010 1.414l-4 4a1 1 0 01-1.414 0z" clip-rule="evenodd"></path>
              </svg>
              <span class="ml-1 text-sm font-medium text-gray-500 md:ml-2">Forking Workflow</span>
            </div>
          </li>
        </ol>
      </nav>
    </div>

    <div class="mb-8">
      <h1 class="text-3xl font-bold text-gray-900 mb-4">Forking Workflow</h1>
      <p class="text-lg text-gray-600">
        Git workflow and collaboration guidelines for the AAIE project. Learn how to contribute effectively 
        using the fork-based workflow and maintain code quality standards.
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 mb-8">
      <!-- Getting Started -->
      <div class="card">
        <div class="flex items-center mb-4">
          <div class="w-10 h-10 bg-blue-100 rounded-lg flex items-center justify-center">
            <svg class="w-6 h-6 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
            </svg>
          </div>
          <h3 class="text-lg font-semibold text-gray-900 ml-3">Getting Started</h3>
        </div>
        <p class="text-gray-600 mb-4">Initial setup and repository forking process.</p>
        <a href="/forking-worflow/getting-started/" class="text-blue-600 hover:text-blue-800 font-medium">View →</a>
      </div>

      <!-- Branch Strategy -->
      <div class="card">
        <div class="flex items-center mb-4">
          <div class="w-10 h-10 bg-green-100 rounded-lg flex items-center justify-center">
            <svg class="w-6 h-6 text-green-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 7h.01M7 3h5c.512 0 1.024.195 1.414.586l7 7a2 2 0 010 2.828l-7 7a2 2 0 01-2.828 0l-7-7A1.994 1.994 0 013 12V7a4 4 0 014-4z"></path>
            </svg>
          </div>
          <h3 class="text-lg font-semibold text-gray-900 ml-3">Branch Strategy</h3>
        </div>
        <p class="text-gray-600 mb-4">Branch naming conventions and management.</p>
        <a href="/forking-worflow/branching/" class="text-green-600 hover:text-green-800 font-medium">View →</a>
      </div>

      <!-- Pull Request Process -->
      <div class="card">
        <div class="flex items-center mb-4">
          <div class="w-10 h-10 bg-purple-100 rounded-lg flex items-center justify-center">
            <svg class="w-6 h-6 text-purple-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z"></path>
            </svg>
          </div>
          <h3 class="text-lg font-semibold text-gray-900 ml-3">Pull Request Process</h3>
        </div>
        <p class="text-gray-600 mb-4">Creating and reviewing pull requests.</p>
        <a href="/forking-worflow/pull-requests/" class="text-purple-600 hover:text-purple-800 font-medium">View →</a>
      </div>

      <!-- Code Review -->
      <div class="card">
        <div class="flex items-center mb-4">
          <div class="w-10 h-10 bg-orange-100 rounded-lg flex items-center justify-center">
            <svg class="w-6 h-6 text-orange-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"></path>
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"></path>
            </svg>
          </div>
          <h3 class="text-lg font-semibold text-gray-900 ml-3">Code Review</h3>
        </div>
        <p class="text-gray-600 mb-4">Code review guidelines and best practices.</p>
        <a href="/forking-worflow/code-review/" class="text-orange-600 hover:text-orange-800 font-medium">View →</a>
      </div>

      <!-- Testing Requirements -->
      <div class="card">
        <div class="flex items-center mb-4">
          <div class="w-10 h-10 bg-red-100 rounded-lg flex items-center justify-center">
            <svg class="w-6 h-6 text-red-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path>
            </svg>
          </div>
          <h3 class="text-lg font-semibold text-gray-900 ml-3">Testing Requirements</h3>
        </div>
        <p class="text-gray-600 mb-4">Testing standards and requirements for contributions.</p>
        <a href="/forking-worflow/testing/" class="text-red-600 hover:text-red-800 font-medium">View →</a>
      </div>

      <!-- Release Process -->
      <div class="card">
        <div class="flex items-center mb-4">
          <div class="w-10 h-10 bg-indigo-100 rounded-lg flex items-center justify-center">
            <svg class="w-6 h-6 text-indigo-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 16a4 4 0 01-.88-7.903A5 5 0 1115.9 6L16 6a5 5 0 011 9.9M9 19l3 3m0 0l3-3m-3 3V10"></path>
            </svg>
          </div>
          <h3 class="text-lg font-semibold text-gray-900 ml-3">Release Process</h3>
        </div>
        <p class="text-gray-600 mb-4">Release management and deployment procedures.</p>
        <a href="/forking-worflow/releases/" class="text-indigo-600 hover:text-indigo-800 font-medium">View →</a>
      </div>
    </div>

    <div class="bg-red-50 rounded-lg p-6">
      <h2 class="text-lg font-semibold text-red-900 mb-2">Workflow Overview</h2>
      <p class="text-red-700 mb-4">
        The forking workflow enables distributed collaboration while maintaining code quality and project stability. 
        Contributors fork the main repository, make changes in feature branches, and submit pull requests for review. 
        This process ensures code quality through peer review and maintains a clean project history.
      </p>
    </div>

    <div class="mt-8 bg-gray-50 rounded-lg p-6">
      <h2 class="text-lg font-semibold text-gray-900 mb-4">Quick Reference</h2>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
        <div>
          <h3 class="font-medium text-gray-900 mb-2">Basic Commands</h3>
          <ul class="text-sm text-gray-600 space-y-1">
            <li><code class="bg-gray-200 px-1 rounded">git clone [fork-url]</code></li>
            <li><code class="bg-gray-200 px-1 rounded">git checkout -b feature-name</code></li>
            <li><code class="bg-gray-200 px-1 rounded">git push origin feature-name</code></li>
          </ul>
        </div>
        <div>
          <h3 class="font-medium text-gray-900 mb-2">Best Practices</h3>
          <ul class="text-sm text-gray-600 space-y-1">
            <li>• Keep commits atomic and focused</li>
            <li>• Write clear commit messages</li>
            <li>• Test before submitting PRs</li>
          </ul>
        </div>
      </div>
    </div>
  </div>
</Layout>
