---
import Layout from '../../layouts/Layout.astro';
---

<Layout title="Model Lab - AAIE Documentation">
  <div class="px-4 sm:px-6 lg:px-8">
    <div class="mb-8">
      <nav class="flex" aria-label="Breadcrumb">
        <ol class="inline-flex items-center space-x-1 md:space-x-3">
          <li class="inline-flex items-center">
            <a href="/" class="text-gray-500 hover:text-gray-700">Home</a>
          </li>
          <li>
            <div class="flex items-center">
              <svg class="w-6 h-6 text-gray-400" fill="currentColor" viewBox="0 0 20 20">
                <path fill-rule="evenodd" d="M7.293 14.707a1 1 0 010-1.414L10.586 10 7.293 6.707a1 1 0 011.414-1.414l4 4a1 1 0 010 1.414l-4 4a1 1 0 01-1.414 0z" clip-rule="evenodd"></path>
              </svg>
              <span class="ml-1 text-sm font-medium text-gray-500 md:ml-2">Model Lab</span>
            </div>
          </li>
        </ol>
      </nav>
    </div>

    <div class="mb-8">
      <h1 class="text-3xl font-bold text-gray-900 mb-4">Model Lab Documentation</h1>
      <p class="text-lg text-gray-600">
        AI model development, training, and evaluation documentation for the AAIE project. Explore model architectures, 
        training pipelines, and evaluation methodologies.
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 mb-8">
      <!-- Model Architecture -->
      <div class="card">
        <div class="flex items-center mb-4">
          <div class="w-10 h-10 bg-blue-100 rounded-lg flex items-center justify-center">
            <svg class="w-6 h-6 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19.428 15.428a2 2 0 00-1.022-.547l-2.387-.477a6 6 0 00-3.86.517l-.318.158a6 6 0 01-3.86.517L6.05 15.21a2 2 0 00-1.806.547M8 4h8l-1 1v5.172a2 2 0 00.586 1.414l5 5c1.26 1.26.367 3.414-1.415 3.414H4.828c-1.782 0-2.674-2.154-1.414-3.414l5-5A2 2 0 009 10.172V5L8 4z"></path>
            </svg>
          </div>
          <h3 class="text-lg font-semibold text-gray-900 ml-3">Model Architecture</h3>
        </div>
        <p class="text-gray-600 mb-4">Neural network architectures and model designs.</p>
        <a href="/aaie-model-lab/architecture/" class="text-blue-600 hover:text-blue-800 font-medium">View →</a>
      </div>

      <!-- Training Pipeline -->
      <div class="card">
        <div class="flex items-center mb-4">
          <div class="w-10 h-10 bg-green-100 rounded-lg flex items-center justify-center">
            <svg class="w-6 h-6 text-green-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"></path>
            </svg>
          </div>
          <h3 class="text-lg font-semibold text-gray-900 ml-3">Training Pipeline</h3>
        </div>
        <p class="text-gray-600 mb-4">Model training workflows and optimization strategies.</p>
        <a href="/aaie-model-lab/training/" class="text-green-600 hover:text-green-800 font-medium">View →</a>
      </div>

      <!-- Evaluation -->
      <div class="card">
        <div class="flex items-center mb-4">
          <div class="w-10 h-10 bg-purple-100 rounded-lg flex items-center justify-center">
            <svg class="w-6 h-6 text-purple-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"></path>
            </svg>
          </div>
          <h3 class="text-lg font-semibold text-gray-900 ml-3">Evaluation</h3>
        </div>
        <p class="text-gray-600 mb-4">Model performance metrics and evaluation frameworks.</p>
        <a href="/aaie-model-lab/evaluation/" class="text-purple-600 hover:text-purple-800 font-medium">View →</a>
      </div>

      <!-- Hyperparameter Tuning -->
      <div class="card">
        <div class="flex items-center mb-4">
          <div class="w-10 h-10 bg-orange-100 rounded-lg flex items-center justify-center">
            <svg class="w-6 h-6 text-orange-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z"></path>
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"></path>
            </svg>
          </div>
          <h3 class="text-lg font-semibold text-gray-900 ml-3">Hyperparameter Tuning</h3>
        </div>
        <p class="text-gray-600 mb-4">Optimization techniques and parameter search strategies.</p>
        <a href="/aaie-model-lab/hyperparameters/" class="text-orange-600 hover:text-orange-800 font-medium">View →</a>
      </div>

      <!-- Model Deployment -->
      <div class="card">
        <div class="flex items-center mb-4">
          <div class="w-10 h-10 bg-red-100 rounded-lg flex items-center justify-center">
            <svg class="w-6 h-6 text-red-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 16a4 4 0 01-.88-7.903A5 5 0 1115.9 6L16 6a5 5 0 011 9.9M9 19l3 3m0 0l3-3m-3 3V10"></path>
            </svg>
          </div>
          <h3 class="text-lg font-semibold text-gray-900 ml-3">Model Deployment</h3>
        </div>
        <p class="text-gray-600 mb-4">Production deployment and serving strategies.</p>
        <a href="/aaie-model-lab/deployment/" class="text-red-600 hover:text-red-800 font-medium">View →</a>
      </div>

      <!-- Research Papers -->
      <div class="card">
        <div class="flex items-center mb-4">
          <div class="w-10 h-10 bg-indigo-100 rounded-lg flex items-center justify-center">
            <svg class="w-6 h-6 text-indigo-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.746 0 3.332.477 4.5 1.253v13C19.832 18.477 18.246 18 16.5 18c-1.746 0-3.332.477-4.5 1.253"></path>
            </svg>
          </div>
          <h3 class="text-lg font-semibold text-gray-900 ml-3">Research Papers</h3>
        </div>
        <p class="text-gray-600 mb-4">Academic papers and research contributions.</p>
        <a href="/aaie-model-lab/research/" class="text-indigo-600 hover:text-indigo-800 font-medium">View →</a>
      </div>
    </div>

    <div class="bg-purple-50 rounded-lg p-6">
      <h2 class="text-lg font-semibold text-purple-900 mb-2">Model Lab Overview</h2>
      <p class="text-purple-700 mb-4">
        The Model Lab is where cutting-edge AI models are developed, trained, and evaluated for educational assessment. 
        It combines research innovation with practical implementation to create intelligent systems that enhance learning outcomes.
      </p>
    </div>
  </div>
</Layout>
