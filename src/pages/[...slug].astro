---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import { formatDate } from '../utils/date';

export const prerender = true;

// Generate static paths for all documentation pages
export async function getStaticPaths() {
  const aaie = await getCollection('aaie');
  const dataHub = await getCollection('aaie-data-hub');
  const modelLab = await getCollection('aaie-model-lab');
  const designEngineering = await getCollection('aaie-design-engineering');
  const deprecated = await getCollection('deprecated');
  const forkingWorkflow = await getCollection('forking-worflow');

  const paths = [
    // Core AAIE pages
    ...aaie.map((doc) => ({
      params: { slug: `aaie/${doc.slug}` },
      props: { 
        entry: doc,
        type: 'aaie',
        category: doc.data.category || 'core'
      },
    })),
    // Data Hub pages
    ...dataHub.map((doc) => ({
      params: { slug: `aaie-data-hub/${doc.slug}` },
      props: { 
        entry: doc,
        type: 'data-hub',
        category: doc.data.category || 'data'
      },
    })),
    // Model Lab pages
    ...modelLab.map((doc) => ({
      params: { slug: `aaie-model-lab/${doc.slug}` },
      props: { 
        entry: doc,
        type: 'model-lab',
        category: doc.data.category || 'models'
      },
    })),
    // Design Engineering pages
    ...designEngineering.map((doc) => ({
      params: { slug: `aaie-design-engineering/${doc.slug}` },
      props: { 
        entry: doc,
        type: 'design-engineering',
        category: doc.data.category || 'design'
      },
    })),
    // Deprecated pages
    ...deprecated.map((doc) => ({
      params: { slug: `deprecated/${doc.slug}` },
      props: { 
        entry: doc,
        type: 'deprecated',
        category: doc.data.category || 'deprecated'
      },
    })),
    // Forking Workflow pages
    ...forkingWorkflow.map((doc) => ({
      params: { slug: `forking-worflow/${doc.slug}` },
      props: { 
        entry: doc,
        type: 'forking-workflow',
        category: doc.data.category || 'workflow'
      },
    })),

  ];

  console.log('Generated paths:', paths.map(p => p.params.slug));
  return paths;
}

// Get the entry data from props
const { entry, type, category } = Astro.props;

// Determine the collection name based on the type
function getCollectionName(type: string): string {
  switch (type) {
    case 'aaie': return 'Core AAIE';
    case 'data-hub': return 'Data Hub';
    case 'model-lab': return 'Model Lab';
    case 'design-engineering': return 'Design Engineering';
    case 'deprecated': return 'Deprecated';
    case 'forking-workflow': return 'Forking Workflow';
    case 'doc': return 'Documentation';
    case 'meeting': return 'Meeting Notes';
    case 'tech-ref': return 'Technical Reference';
    default: return 'Documentation';
  }
}

// Get the breadcrumb path based on the type
function getBreadcrumbPath(type: string): string {
  switch (type) {
    case 'aaie': return '/aaie';
    case 'data-hub': return '/aaie-data-hub';
    case 'model-lab': return '/aaie-model-lab';
    case 'design-engineering': return '/aaie-design-engineering';
    case 'deprecated': return '/deprecated';
    case 'forking-workflow': return '/forking-worflow';
    default: return '/';
  }
}

// Get the breadcrumb label based on the type
function getBreadcrumbLabel(type: string): string {
  switch (type) {
    case 'aaie': return 'Core AAIE';
    case 'data-hub': return 'Data Hub';
    case 'model-lab': return 'Model Lab';
    case 'design-engineering': return 'Design Engineering';
    case 'deprecated': return 'Deprecated';
    case 'forking-workflow': return 'Forking Workflow';
    default: return 'Documentation';
  }
}

const { Content } = await entry.render();

// Get related content (placeholder for now)
const relatedContent = [];

// Generate page title and description
const pageTitle = entry.data.title;
const pageDescription = entry.data.description || `Documentation for ${entry.data.title}`;
const pageCategory = category.charAt(0).toUpperCase() + category.slice(1).replace('-', ' ');
---

<Layout title={`${pageTitle} - AAIE Documentation`} description={pageDescription}>
  <div class="px-4 sm:px-6 lg:px-8">
    <!-- Breadcrumb Navigation -->
    <div class="mb-8">
      <nav class="flex" aria-label="Breadcrumb">
        <ol class="inline-flex items-center space-x-1 md:space-x-3">
          <li class="inline-flex items-center">
            <a href="/" class="text-gray-500 hover:text-gray-700">Home</a>
          </li>
          <li>
            <div class="flex items-center">
              <svg class="w-6 h-6 text-gray-400" fill="currentColor" viewBox="0 0 20 20">
                <path fill-rule="evenodd" d="M7.293 14.707a1 1 0 010-1.414L10.586 10 7.293 6.707a1 1 0 011.414-1.414l4 4a1 1 0 010 1.414l-4 4a1 1 0 01-1.414 0z" clip-rule="evenodd"></path>
              </svg>
              <a href={getBreadcrumbPath(type)} class="ml-1 text-sm font-medium text-gray-500 hover:text-gray-700 md:ml-2">
                {getBreadcrumbLabel(type)}
              </a>
            </div>
          </li>
          <li>
            <div class="flex items-center">
              <svg class="w-6 h-6 text-gray-400" fill="currentColor" viewBox="0 0 20 20">
                <path fill-rule="evenodd" d="M7.293 14.707a1 1 0 010-1.414L10.586 10 7.293 6.707a1 1 0 011.414-1.414l4 4a1 1 0 010 1.414l-4 4a1 1 0 01-1.414 0z" clip-rule="evenodd"></path>
              </svg>
              <span class="ml-1 text-sm font-medium text-gray-500 md:ml-2">{pageTitle}</span>
            </div>
          </li>
        </ol>
      </nav>
    </div>

    <!-- Page Header -->
    <div class="mb-8">
      <div class="flex items-center mb-4">
        <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-blue-100 text-blue-800">
          {getCollectionName(type)}
        </span>
        {entry.data.category && (
          <span class="ml-2 inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-gray-100 text-gray-800">
            {entry.data.category}
          </span>
        )}
      </div>
      
      <h1 class="text-3xl font-bold text-gray-900 mb-4">{pageTitle}</h1>
      
      {pageDescription && (
        <p class="text-lg text-gray-600 mb-4">{pageDescription}</p>
      )}

      <!-- Metadata -->
      <div class="flex flex-wrap items-center text-sm text-gray-500 space-x-4">
        {entry.data.author && (
          <span>By {entry.data.author}</span>
        )}
        {entry.data.date && (
          <span>Published {formatDate(entry.data.date)}</span>
        )}
        {entry.data.lastUpdated && (
          <span>Updated {formatDate(entry.data.lastUpdated)}</span>
        )}
        {entry.data.tags && entry.data.tags.length > 0 && (
          <div class="flex items-center space-x-2">
            <span>Tags:</span>
            {entry.data.tags.map(tag => (
              <span class="inline-flex items-center px-2 py-1 rounded-full text-xs font-medium bg-gray-100 text-gray-800">
                {tag}
              </span>
            ))}
          </div>
        )}
      </div>
    </div>

    <!-- Main Content -->
    <div class="grid grid-cols-1 lg:grid-cols-4 gap-8">
      <!-- Content Area -->
      <div class="lg:col-span-3">
        <div class="prose prose-lg max-w-none bg-white rounded-lg shadow-sm p-8">
          <Content />
        </div>
      </div>

      <!-- Sidebar -->
      <div class="lg:col-span-1">
        <div class="sticky top-8">
          <!-- Table of Contents -->
          <div class="bg-white rounded-lg shadow-sm p-6 mb-6">
            <h3 class="text-lg font-semibold text-gray-900 mb-4">On This Page</h3>
            <nav class="space-y-2" id="toc">
              <!-- TOC will be populated by JavaScript -->
            </nav>
          </div>

          <!-- Related Content -->
          {relatedContent.length > 0 && (
            <div class="bg-white rounded-lg shadow-sm p-6">
              <h3 class="text-lg font-semibold text-gray-900 mb-4">Related</h3>
              <ul class="space-y-3">
                {relatedContent.map(doc => (
                  <li>
                    <a href={`/docs/${doc.slug}`} class="text-blue-600 hover:text-blue-800 hover:underline">
                      {doc.data.title}
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          )}

          <!-- Quick Actions -->
          <div class="bg-white rounded-lg shadow-sm p-6 mt-6">
            <h3 class="text-lg font-semibold text-gray-900 mb-4">Quick Actions</h3>
            <div class="space-y-3">
              <a href={`/docs/${entry.slug}.md`} class="flex items-center text-sm text-gray-600 hover:text-gray-900">
                <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4"></path>
                </svg>
                View Source
              </a>
              <a href={`https://github.com/KhushiChoubey26/aaie-documentation/edit/development/src/content/docs/${entry.slug}.md`} class="flex items-center text-sm text-gray-600 hover:text-gray-900">
                <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"></path>
                </svg>
                Edit on GitHub
              </a>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</Layout>

<script>
  // Generate table of contents from headings
  document.addEventListener('DOMContentLoaded', function() {
    const content = document.querySelector('.prose');
    const toc = document.getElementById('toc');
    
    if (content && toc) {
      const headings = content.querySelectorAll('h1, h2, h3, h4, h5, h6');
      const tocItems = [];
      
      headings.forEach((heading, index) => {
        const level = parseInt(heading.tagName.charAt(1));
        const text = heading.textContent;
        const id = `heading-${index}`;
        
        heading.id = id;
        
        const tocItem = document.createElement('a');
        tocItem.href = `#${id}`;
        tocItem.textContent = text;
        tocItem.className = `block text-sm text-gray-600 hover:text-gray-900 py-1 ${level > 2 ? 'ml-4' : ''}`;
        
        toc.appendChild(tocItem);
      });
    }
  });
</script>
