---
import Layout from '../layouts/Layout.astro';
---

<Layout title="AAIE Documentation">
  <main class="container mx-auto px-4 py-8">
    <!-- Hero Section -->
    <div class="text-center mb-12">
      <h1 class="text-4xl font-bold text-gray-900 mb-4">
        AAIE Documentation
      </h1>
      <p class="text-xl text-gray-600 max-w-3xl mx-auto">
        Comprehensive documentation for the Artificial Assessment Intelligence for Educators (AAIE) project. Explore architecture diagrams, meeting notes, technical references, and more.
      </p>
    </div>

    <!-- Documentation Sections Grid -->
    <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6">
      <!-- Core AAIE -->
      <div class="bg-white rounded-lg shadow-md p-6 border border-gray-200 hover:shadow-lg transition-shadow">
        <h2 class="text-2xl font-semibold text-gray-900 mb-3">Core AAIE</h2>
        <p class="text-gray-600 mb-4">
          Core project documentation, architecture, and implementation details.
        </p>
        <a href="/aaie/overview/" class="inline-block bg-blue-600 text-white px-4 py-2 rounded-md hover:bg-blue-700 transition-colors">
          Explore →
        </a>
      </div>

      <!-- Data Hub -->
      <div class="bg-white rounded-lg shadow-md p-6 border border-gray-200 hover:shadow-lg transition-shadow">
        <h2 class="text-2xl font-semibold text-gray-900 mb-3">Data Hub</h2>
        <p class="text-gray-600 mb-4">
          Data management, storage, and processing documentation.
        </p>
        <a href="/aaie-data-hub/overview/" class="inline-block bg-blue-600 text-white px-4 py-2 rounded-md hover:bg-blue-700 transition-colors">
          Explore →
        </a>
      </div>

      <!-- Model Lab -->
      <div class="bg-white rounded-lg shadow-md p-6 border border-gray-200 hover:shadow-lg transition-shadow">
        <h2 class="text-2xl font-semibold text-gray-900 mb-3">Model Lab</h2>
        <p class="text-gray-600 mb-4">
          AI model development, training, and evaluation documentation.
        </p>
        <a href="/aaie-model-lab/overview/" class="inline-block bg-blue-600 text-white px-4 py-2 rounded-md hover:bg-blue-700 transition-colors">
          Explore →
        </a>
      </div>

      <!-- Design Engineering -->
      <div class="bg-white rounded-lg shadow-md p-6 border border-gray-200 hover:shadow-lg transition-shadow">
        <h2 class="text-2xl font-semibold text-gray-900 mb-3">Design Engineering</h2>
        <p class="text-gray-600 mb-4">
          System design, architecture, and engineering documentation.
        </p>
        <a href="/aaie-design-engineering/overview/" class="inline-block bg-blue-600 text-white px-4 py-2 rounded-md hover:bg-blue-700 transition-colors">
          Explore →
        </a>
      </div>

      <!-- Forking Workflow -->
      <div class="bg-white rounded-lg shadow-md p-6 border border-gray-200 hover:shadow-lg transition-shadow">
        <h2 class="text-2xl font-semibold text-gray-900 mb-3">Forking Workflow</h2>
        <p class="text-gray-600 mb-4">
          Git workflow and collaboration guidelines for the project.
        </p>
        <a href="/forking-worflow/overview/" class="inline-block bg-blue-600 text-white px-4 py-2 rounded-md hover:bg-blue-700 transition-colors">
          Explore →
        </a>
      </div>

      <!-- Deprecated -->
      <div class="bg-white rounded-lg shadow-md p-6 border border-gray-200 hover:shadow-lg transition-shadow">
        <h2 class="text-2xl font-semibold text-gray-900 mb-3">Deprecated</h2>
        <p class="text-gray-600 mb-4">
          Outdated documentation and deprecated features.
        </p>
        <a href="/deprecated/archive-overview/" class="inline-block bg-blue-600 text-white px-4 py-2 rounded-md hover:bg-blue-700 transition-colors">
          Explore →
        </a>
      </div>
    </div>
  </main>
</Layout>
